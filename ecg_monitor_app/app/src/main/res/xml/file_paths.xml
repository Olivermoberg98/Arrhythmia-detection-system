<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider path configuration for ExportManager.

    external-files-path maps to Context.getExternalFilesDir(null), which is
    where ExportManager writes its PDF and CSV files. This directory is
    app-private, requires no WRITE_EXTERNAL_STORAGE permission, and is
    automatically removed when the app is uninstalled.

    path="." grants access to the root of that directory so any filename
    ExportManager produces can be shared without further configuration.
-->
<paths>
    <external-files-path
        name="ecg_exports"
        path="." />
</paths>